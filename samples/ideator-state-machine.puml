@startuml
skinparam dpi 110
skinparam defaultFontName SansSerif
skinparam defaultFontSize 13
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam wrapWidth 320
skinparam maxMessageSize 300
skinparam ArrowColor #1E293B
skinparam titleFontSize 20
skinparam titleFontStyle bold
skinparam noteBackgroundColor #F1F5F9
skinparam noteBorderColor #64748B
skinparam noteFontSize 12
skinparam legendBackgroundColor #FFFFFF
skinparam legendBorderColor #94A3B8
skinparam legendFontSize 12
skinparam state {
  BackgroundColor #F8FAFC
  BorderColor #334155
  FontSize 13
  AttributeFontSize 12
}
skinparam state<<pause>> {
  BackgroundColor #FFF3C4
  BorderColor #B45309
}
skinparam state<<drive>> {
  BackgroundColor #E0F2FE
  BorderColor #0369A1
}
title Ideator — state machine (designed workflow, 2026-11-10)

[*] --> Idle

state Idle : waiting for a message
state Greeting : intro (Double Diamond, pretotypes,\nsourced claims, hypothesis label)\n+ Tip + knobs list with defaults\n(template as full URL) + example problem
Idle --> Greeting : greeting / no problem statement
Greeting --> Idle : ask "What's the problem?"
Idle --> ParseKnobs : problem statement received

state ParseKnobs : 8 knobs: ideas 5, pretotypes 4, sources 5,\ncountry (given > inferred > United States),\nlanguage (given > message language > English),\nformat = sheet only, mode (saved; default auto),\ntemplate (Ideator Template URL | id/URL | none)\nper-run only; only mode is saved to memory\nrecord run_started (with seconds); no opening message
ParseKnobs --> Discover

state "Diamond 1 — problem space" as D1 {
  state Discover : web research on the country market\ncite <sources> distinct sources (ID, URL,\nsummary + limitations), challenges C1..C10,\neach cited or "hypothesis, no evidence found"\nsticky note per challenge\nentry / save research to run JSON
  state Define : rate Possible 1-5 + Exciting 1-5\nScore = Possible + Exciting; rank\ntop 5 max; ties: Exciting > Possible > ID\nentry / save ratings + picks to JSON
  state ModeD1 <<choice>>
  state PauseDefine <<pause>> : PAUSE (ask mode)\nshow ranked challenges;\nuser chooses / steers picks
  Discover --> Define
  Define --> ModeD1
  ModeD1 --> PauseDefine : [mode = ask]
  ModeD1 --> AutoDefine : [mode = auto]
  state AutoDefine : auto-pick top 5 challenges\nwrite pick + reason in sheet
}

state "Diamond 2 — solution space" as D2 {
  state Develop : <ideas> ideas per picked challenge\n(IDs C4-I1 ...), fitted to the country's\nculture, habits and rules\nentry / save ideas to JSON
  state Deliver : base = Cheap + Simple (2-10)\nx evidence (strong 1.3 / some 1.15 / none 1.0)\nx uniqueness (non-obvious 1.2 / somewhat 1.1 / obvious 1.0)\nweighted, rounded half up to 1 decimal; top 5\nties: evidence > uniqueness > Simple > Cheap,\nthen lowest ID marked "unresolved tie, order arbitrary"\nconcepts = mixed ideas, ranked by avg weighted score\n(ties: avg evidence, then more ideas)\nentry / save ratings, picks, concepts to JSON
  state ModeD2 <<choice>>
  state PauseDeliver <<pause>> : PAUSE (ask mode)\nshow ranked ideas + concepts;\nuser chooses concepts to pretotype
  state AutoDeliver : auto-pick top 5 ideas\n+ top 2 concepts, with reasons
  Develop --> Deliver
  Deliver --> ModeD2
  ModeD2 --> PauseDeliver : [mode = ask]
  ModeD2 --> AutoDeliver : [mode = auto]
}
PauseDefine --> Develop : user answers
AutoDefine --> Develop

state Pretotypes : <pretotypes> tests across picked concepts\n(best concept first, >= 1 each if possible)\nhypothesis, success number, deadline,\none testable line, go / no-go;\none recommended first test per concept\nmaterials drafted (never sent / posted)\nentry / save to JSON
PauseDeliver --> Pretotypes : user answers
AutoDeliver --> Pretotypes

state ModeP <<choice>>
Pretotypes --> ModeP
state PauseTests <<pause>> : PAUSE (ask mode)\nwhich tests run, and start dates?
state AutoTests : recommended first tests = selected\ncheck-in status: "set up when you\ngive a start date"
ModeP --> PauseTests : [mode = ask]
ModeP --> AutoTests : [mode = auto]

state "Report build" as Build {
  state TplChoice <<choice>>
  state ExportTemplate <<drive>> : export_file template once (xlsx)\ntemplate is read-only, never modified
  state LocalTemplate : sheet_builder.py --template\ntemplate's own tabs first, read-only\n(fingerprint-checked); 15 report tabs\nrebuilt in place / added after, row 1, no branding
  state LocalScratch : sheet_builder.py (no template)\n15 report tabs from scratch
  state Upload <<drive>> : ONE create_file upload\nxlsx -> native Google Sheet\ntitle <problem>-YYYY-MM-DD-HHMM
  state Verify <<drive>> : get_file_metadata (native, run name;\nrename copy if needed), get_file_permissions\n(never shared), one export_file compare
  [*] --> TplChoice : set run_stopped
  TplChoice --> ExportTemplate : [template set]
  TplChoice --> LocalScratch : [template: none]
  ExportTemplate --> LocalTemplate
  LocalTemplate --> Upload
  LocalScratch --> Upload
  Upload --> Verify
}
PauseTests --> Build
AutoTests --> Build

state NoDrive : say "connect Google Drive"\nstop; no other delivery
Build --> NoDrive : Drive connector missing
NoDrive --> [*]

state Delivered : final chat delivery (once):\nproblem verbatim, Run knobs (8 lines),\n"Here is the result.", sheet-name link
Build --> Delivered : verified

state FollowUp : one-time routine per selected test,\nfires day after its deadline
state Results : ask results, compare with success number,\nrecommend go / no-go / iterate,\nupdate JSON, rebuild, upload NEW sheet\n(update time), delete spent routine
Delivered --> FollowUp : start date known\n(create routine)
Delivered --> [*] : no start date yet
FollowUp --> Results : routine fires
Results --> [*]

state Cancelled : stop all work, rebuild sheet with\nProblem "Cancelled" = CANCELLED,\nupload new sheet, delete follow-up routine
D1 --> Cancelled : user cancels
D2 --> Cancelled : user cancels
FollowUp --> Cancelled : user cancels
Cancelled --> [*]

legend bottom
  Yellow = PAUSE (ask mode only; auto mode skips every PAUSE and never stops early)
  Blue = Google Drive connector step. Never delete anything on Drive; older sheets are never overwritten.
endlegend
@enduml
